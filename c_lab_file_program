#include <stdio.h>
#include <string.h>

void selection_sort(char str[][50])
{
	char temp[50];


	for (int i =0; i< 5; i++)
	{
		int min = i;
		for(int j=i; j< 5; j++)
		{
			if(strcmp(str[j],str[min])<0)
			{
				min = j;
			}
		}
		strcpy(temp,str[i]);
		strcpy(str[i],str[min]);
		strcpy(str[min],temp);

	}


}
int binary_search(char str[][50], char *target)
{
	int left = 0, right = 4;

	while (left <= right)
	{
		int mid = left + (right - left) / 2;

		int res = strcmp(str[mid], target);

		if (res == 0)
		{
			return mid;
		}
		else if (res > 0)
		{
			
			right = mid - 1;
		}
		else
		{
			
			left = mid + 1;
		}
	}

	return -1;
}


int main() {
	
