    };

    char syllabus[5][50] =
    {
        "Arrays",
        "Linked List",
        "Stack",
        "Queue",
        "Trees"
    };

    struct SNode *sHead = NULL;
    struct DNode *dHead;

    int i, j;
    int choice;

    /* Create syllabus-wise singly linked list */

    for (i = 0; i < 5; i++)
    {
        for (j = 0; j < 5; j++)
        {
            if (strcmp(syllabus[i], videos[j].topic) == 0)
            {
                addSingly(&sHead, videos[j]);
                break;
            }
        }
    }

    /* First stage: forward only */
    displaySingly(sHead);

    /* Convert to doubly linked list */
    dHead = convertToDoubly(sHead);

    /* Menu */
    do
