//convert fahrenhiet to celsius

#include<stdio.h>
int main()
{ 
    float fah,c;
    printf("enter the temperature in celsius \n");
    scanf("%f",&c);
    fah=(1.8*c)+32;
    printf("the temperature in fahrenhiet is %0.2f",fah);
    return 0;
}



