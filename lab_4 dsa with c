#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX_USERS 100
#define MAX_ID 30
#define MAX_PASSWORD 100

struct User {
    char user_id[MAX_ID];
    char password[MAX_PASSWORD];
    char strength[20];
};

struct User users[MAX_USERS];
int user_count = 0;

/* Check password strength */
void checkPasswordStrength(char password[], char strength[]) {
    int length = strlen(password);
    int hasUpper = 0, hasLower = 0;
    int hasDigit = 0, hasSpecial = 0;

    for (int i = 0; password[i] != '\0'; i++) {
        if (isupper(password[i]))
            hasUpper = 1;
        else if (islower(password[i]))
            hasLower = 1;
        else if (isdigit(password[i]))
            hasDigit = 1;
        else
            hasSpecial = 1;
    }

    int score = 0;

    if (length >= 8)
        score++;
    if (hasUpper)
        score++;
    if (hasLower)
        score++;
    if (hasDigit)
        score++;
    if (hasSpecial)
        score++;

    if (score <= 2)
        strcpy(strength, "Weak");
    else if (score == 3)
        strcpy(strength, "Medium");
    else if (score == 4)
        strcpy(strength, "Strong");
    else
        strcpy(strength, "Very Strong");
}

/* Add a new user */
void addUser() {
    if (user_count >= MAX_USERS) {
        printf("User storage is full!\n");
        return;
    }
    char id[100],password[100];
    printf("Enter User ID: ");
    scanf("%s", id);

    printf("Enter Password: ");
    scanf("%s", password);

    char strength[20];

    checkPasswordStrength(password, strength);

    printf("Password Strength: %s\n", strength);

    if (strcmp(strength, "Weak") == 0) {
    printf("Password is too weak. User not stored.\n");
    return;
    }

/* Store only after password is accepted */
    strcpy(users[user_count].user_id, id);
    strcpy(users[user_count].password, password);
    strcpy(users[user_count].strength, strength);

    user_count++;

    printf("User stored successfully!\n");
}

/* Search and retrieve user */
void retrieveUser() {
    char id[MAX_ID];
    int found = 0;

    printf("Enter User ID to retrieve: ");
    scanf("%s", id);

    for (int i = 0; i < user_count; i++) {
        if (strcmp(users[i].user_id, id) == 0) {
            printf("\nUser Found!\n");
            printf("User ID: %s\n", users[i].user_id);
            printf("Password Strength: %s\n", users[i].strength);

            found = 1;
            break;
        }
    }

    if (!found) {
        printf("User ID not found!\n");
    }
}

/* Display all users */
void displayUsers() {
    if (user_count == 0) {
        printf("No users stored.\n");
        return;
    }

    printf("\n--- User List ---\n");

    for (int i = 0; i < user_count; i++) {
        printf("User ID: %s | Strength: %s\n",users[i].user_id,users[i].strength);
    }
}

int main() {
    int choice;

    while (1) {
        printf("\n===== USER MANAGEMENT =====\n");
        printf("1. Add User\n");
        printf("2. Retrieve User\n");
        printf("3. Display Users\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addUser();
                break;

            case 2:
                retrieveUser();
                break;

            case 3:
                displayUsers();
                break;

            case 4:
                printf("Program terminated.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
