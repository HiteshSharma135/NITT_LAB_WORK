#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define TABLE_SIZE 100
#define MAX_ID 30
#define MAX_PASSWORD 100

struct User {
    char user_id[MAX_ID];
    char password[MAX_PASSWORD];
    char strength[20];
    int occupied;
};

struct User table[TABLE_SIZE];

int hashFunction(char id[]) {
    int hash = 0;

    for (int i = 0; id[i] != '\0'; i++)
        hash = (hash + id[i]) % TABLE_SIZE;

    return hash;
}

void checkPasswordStrength(char password[], char strength[]) {
    int length = strlen(password);
    int hasUpper = 0, hasLower = 0;
    int hasDigit = 0, hasSpecial = 0;

    for (int i = 0; password[i] != '\0'; i++) {
        if (isupper(password[i]))
            hasUpper = 1;
        else if (islower(password[i]))
            hasLower = 1;
        else if (isdigit(password[i]))
            hasDigit = 1;
        else
            hasSpecial = 1;
    }

    int score = 0;

    if (length >= 8)
        score++;
    if (hasUpper)
        score++;
    if (hasLower)
        score++;
    if (hasDigit)
        score++;
    if (hasSpecial)
        score++;

    if (score <= 2)
        strcpy(strength, "Weak");
    else if (score == 3)
        strcpy(strength, "Medium");
    else if (score == 4)
        strcpy(strength, "Strong");
    else
        strcpy(strength, "Very Strong");
}

void addUser() {
    char id[MAX_ID], password[MAX_PASSWORD];
    char strength[20];

    printf("Enter User ID: ");
    scanf("%29s", id);

    printf("Enter Password: ");
    scanf("%99s", password);

    checkPasswordStrength(password, strength);

    printf("Password Strength: %s\n", strength);

    if (strcmp(strength, "Weak") == 0) {
        printf("Password is too weak. User not stored.\n");
        return;
    }

    int index = hashFunction(id);

    while (table[index].occupied) {
        index = (index + 1) % TABLE_SIZE;
    }

    strcpy(table[index].user_id, id);
    strcpy(table[index].password, password);
    strcpy(table[index].strength, strength);
    table[index].occupied = 1;

    printf("User stored successfully!\n");
}

void retrieveUser() {
    char id[MAX_ID];

    printf("Enter User ID to retrieve: ");
    scanf("%29s", id);

    int index = hashFunction(id);
    int start = index;

    while (table[index].occupied) {
        if (strcmp(table[index].user_id, id) == 0) {
            printf("\nUser Found!\n");
            printf("User ID: %s\n", table[index].user_id);
            printf("Password Strength: %s\n",
                   table[index].strength);
            return;
        }

        index = (index + 1) % TABLE_SIZE;

        if (index == start)
            break;
    }

    printf("User ID not found!\n");
}

void displayUsers() {
    int found = 0;

    printf("\n--- User List ---\n");

    for (int i = 0; i < TABLE_SIZE; i++) {
        if (table[i].occupied) {
            printf("User ID: %s | Strength: %s\n",
                   table[i].user_id,
                   table[i].strength);
            found = 1;
        }
    }

    if (!found)
        printf("No users stored.\n");
}

int main() {
    int choice;

    while (1) {
        printf("\n===== USER MANAGEMENT =====\n");
        printf("1. Add User\n");
        printf("2. Retrieve User\n");
        printf("3. Display Users\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                addUser();
                break;

            case 2:
                retrieveUser();
                break;

            case 3:
                displayUsers();
                break;

            case 4:
                printf("Program terminated.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}
