//to reverse a number
num=int(input("enter the number :"))

reverse=0 // it is used to concatenate the numbers as otherwise its showing the number is different lines

while(num!=0):
    digit=num%10
    reverse=reverse*10+digit// logic is used because we want to concatenate all the digits
    num=int(num/10)
