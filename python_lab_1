//given the ram size ,then we have find the address bus size.

import math

unit=(input("enter the unit of ram size :"))
ram=int(input("enter the ram size: "))

if(unit=='kb'):
    ram=ram*1024
elif unit=='mb':
    ram=ram*1024*1024
else:
    ram=ram*1024*1024*1024

adress_bus=int(math.log(ram,2))

print("the address bus size is: ",adress_bus)


//size of hard disk to no. of bytes it hold
import math

unit=input("enter the unit of size of Hard Disk :")
size=int(input("enter the size of Hard Disk :"))

if(unit == 'kb'):
    bytes=size*pow(2,10)
elif(unit=='mb'):
    bytes=size*pow(2,20)
elif(unit=='gb'):
    bytes=size*pow(2,30)
else:
    bytes=size*pow(2,40)

print("No. of bytes in Hard Disk is: ",bytes)


