// striver pattern --> 22
n=int(input("enter the value of n: "))
for i in range(1,2*n):
    for  j in range(1,2*n):
        top=i
        bottom=2*n-i
        left=j
        right=2*n-j
        m=min(top,bottom,right,left)
        print(n-m+1,end=" ")
    print()


